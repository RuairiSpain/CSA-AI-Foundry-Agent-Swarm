# File: routes/{{ route_name }}/v{{ route_version }}.py
# Generated by: DynamicRouteWriterAgent
# Timestamp: {{ now }}

import asyncio
import logging
from typing import Any, Dict

from semantic_kernel import Kernel
from safe.workflow import TraceContext, WorkflowInput, WorkflowOutput

logger = logging.getLogger(__name__)


async def route_{{ route_name_func }}(
    kernel: Kernel,
    input: WorkflowInput,
    trace_context: TraceContext,
) -> WorkflowOutput:
    """
    Dynamic Route: {{ route_name }}
    
    Description: {{ route_description }}
    Version: {{ route_version }}
    Decision inputs: {% for inp in decision_inputs %}{{ inp }}{{ ", " if not loop.last else "" }}{% endfor %}
    """
    
    with trace_context.span("route_{{ route_name_func }}") as root_span:
        root_span.set_attribute("route_name", "{{ route_name }}")
        root_span.set_attribute("route_version", "{{ route_version }}")
        
        try:
            results = {}
            
            # Extract decision inputs from the input payload
            decision_context = {}
            {%- for inp in decision_inputs %}
            decision_context["{{ inp }}"] = input.get("{{ inp }}", None)
            {%- endfor %}
            
            root_span.add_event("decision_inputs_extracted", decision_context)
            
            # Routing logic: determine which agents to invoke based on conditions
            agents_to_invoke = []
            
            {%- for route in routes %}
            
            # Check condition: {{ route.condition }}
            if ({{ route.condition }}):
                agents_to_invoke.extend({{ route.agents | tojson }})
                logger.info(f"Condition matched: {{ route.condition }} -> agents: {{ route.agents }}")
            {%- endfor %}
            
            {%- if fallback_agents %}
            
            # Fallback: invoke fallback agents if no condition matched
            if not agents_to_invoke:
                agents_to_invoke.extend({{ fallback_agents | tojson }})
                logger.info(f"No conditions matched; using fallback agents: {{ fallback_agents }}")
            {%- endif %}
            
            root_span.add_event("routing_decision", {
                "agents_selected": agents_to_invoke,
                "condition_context": decision_context,
            })
            
            # Invoke selected agents in parallel
            logger.info(f"Invoking agents: {agents_to_invoke}")
            
            tasks = {}
            for agent_name in agents_to_invoke:
                agent = kernel.get_agent(agent_name)
                
                if not agent:
                    logger.error(f"Agent {agent_name} not found in catalog")
                    continue
                
                task = asyncio.create_task(
                    agent.invoke(input, trace_context=trace_context)
                )
                tasks[agent_name] = task
            
            # Gather results with error handling
            for agent_name, task in tasks.items():
                try:
                    result = await asyncio.wait_for(task, timeout=3600)
                    results[agent_name] = result
                    logger.info(f"{agent_name} completed successfully")
                
                except asyncio.TimeoutError:
                    error_msg = f"{agent_name} timeout after 3600s"
                    logger.error(error_msg)
                    results[agent_name] = {"error": error_msg, "success": False}
                
                except Exception as e:
                    error_msg = f"{agent_name} failed: {str(e)}"
                    logger.error(error_msg)
                    results[agent_name] = {"error": error_msg, "success": False}
            
            {%- if orchestrator %}
            
            # Aggregation: orchestrator agent combines results
            orchestrator = kernel.get_agent("{{ orchestrator }}")
            if orchestrator:
                try:
                    final_result = await orchestrator.invoke({
                        "input": input,
                        "results": results,
                        "decision_context": decision_context,
                    }, trace_context=trace_context)
                except Exception as e:
                    logger.error(f"Orchestrator failed: {e}")
                    final_result = {
                        "error": f"Orchestration failed: {str(e)}",
                        "results": results,
                    }
            else:
                final_result = {
                    "error": "Orchestrator agent not found",
                    "results": results,
                }
            
            {%- else %}
            
            # No orchestrator: return raw results
            final_result = {
                "results": results,
                "agents_invoked": list(tasks.keys()),
            }
            
            {%- endif %}
            
            final_result.update({
                "status": "success",
                "route": "{{ route_name }}",
                "version": "{{ route_version }}",
                "decision_context": decision_context,
            })
            
            root_span.add_event("route_complete", {
                "agents_count": len(results),
                "successful": len([r for r in results.values() if r.get("success", True)]),
            })
            
            return final_result
        
        except Exception as e:
            logger.exception(f"Route execution failed: {e}")
            root_span.record_exception(e)
            raise
