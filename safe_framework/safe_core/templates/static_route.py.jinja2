# Generated by: DynamicRouteWriterAgent
# Timestamp: {{ now }}

import asyncio
import logging
from typing import Any, Dict, Optional

from semantic_kernel import Kernel
from safe.workflow import TraceContext, WorkflowInput, WorkflowOutput

logger = logging.getLogger(__name__)


async def route_{{ route_name_func }}(
    kernel: Kernel,
    input: WorkflowInput,
    trace_context: TraceContext,
) -> WorkflowOutput:
    """
    Static Route: {{ route_name }}
    
    Description: {{ route_description }}
    Version: {{ route_version }}
    Pattern: {{ pattern }}
    Agents: {% for agent in agents %}{{ agent.name }}{{ ", " if not loop.last else "" }}{% endfor %}
    """
    
    with trace_context.span("route_{{ route_name_func }}") as root_span:
        root_span.set_attribute("route_name", "{{ route_name }}")
        root_span.set_attribute("route_version", "{{ route_version }}")
        root_span.set_attribute("pattern", "{{ pattern }}")
        
        try:
            # Initialize results tracking
            results = {}
            
            {%- if pattern == "sequential" %}
            
            # Sequential execution: invoke agents one after another
            {%- for agent in agents %}
            
            with trace_context.span("invoke_{{ agent.name }}") as span:
                logger.info("Invoking {{ agent.name }}")
                agent = kernel.get_agent("{{ agent.name }}")
                
                if not agent:
                    {%- if agent.error_policy == "fail_hard" %}
                    raise ValueError("Agent {{ agent.name }} not found in catalog")
                    {%- else %}
                    logger.warning("Agent {{ agent.name }} not found; skipping")
                    continue
                    {%- endif %}
                
                try:
                    # Use previous result as input, or original input for first agent
                    agent_input = results.get("previous", input) if results else input
                    
                    result = await asyncio.wait_for(
                        agent.invoke(agent_input, trace_context=trace_context),
                        timeout={{ agent.timeout }}
                    )
                    
                    results["{{ agent.name }}"] = result
                    results["previous"] = result
                    span.add_event("success")
                    
                except asyncio.TimeoutError:
                    msg = f"{{ agent.name }} timeout after {{ agent.timeout }}s"
                    {%- if agent.error_policy == "fail_hard" %}
                    logger.error(msg)
                    raise TimeoutError(msg)
                    {%- else %}
                    logger.warning(msg)
                    {%- endif %}
                
                except Exception as e:
                    msg = f"{{ agent.name }} failed: {e}"
                    {%- if agent.error_policy == "fail_hard" %}
                    logger.error(msg)
                    raise
                    {%- else %}
                    logger.warning(msg)
                    {%- endif %}
            
            {%- endfor %}
            
            {%- elif pattern == "fan_out" %}
            
            # Fan-out execution: invoke all agents in parallel
            tasks = {}
            
            {%- for agent in agents %}
            agent = kernel.get_agent("{{ agent.name }}")
            if agent:
                tasks["{{ agent.name }}"] = asyncio.create_task(
                    agent.invoke(input, trace_context=trace_context)
                )
            {%- endfor %}
            
            # Gather results
            for agent_name, task in tasks.items():
                try:
                    result = await asyncio.wait_for(task, timeout=3600)
                    results[agent_name] = result
                except asyncio.TimeoutError:
                    logger.warning(f"{agent_name} timeout")
                except Exception as e:
                    logger.error(f"{agent_name} failed: {e}")
            
            {%- endif %}
            
            # Return final result
            final_result = {
                "status": "success",
                "results": results,
                "agents_count": len(results),
                "route": "{{ route_name }}",
                "version": "{{ route_version }}",
            }
            
            root_span.add_event("route_complete", final_result)
            return final_result
        
        except Exception as e:
            logger.exception(f"Route execution failed: {e}")
            root_span.record_exception(e)
            raise
