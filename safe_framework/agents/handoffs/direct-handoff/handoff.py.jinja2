import logging
from datetime import datetime
from typing import Any, Dict, Optional

from azure.ai.projects.aio import AIProjectClient
from azure.ai.projects.models import ConnectedAgentTool, MessageRole

logger = logging.getLogger(__name__)


class {{ class_name }}Handoff:
    """
    {{ handoff_name }}{% if description %} — {{ description }}{% endif %}

    Pattern       : {{ pattern }}
    Delegate      : {{ delegate.name if delegate else 'delegate' }}
    Return policy : {{ return_policy }}
    Created       : {{ created_at }}

    Delegates the entire task to a single connected sub-agent and returns
    its response. Control flows back to the caller after the sub-agent
    completes (or fails, depending on return_policy).
    """

    def __init__(self, client: AIProjectClient, delegate_agent_id: str) -> None:
        self._client = client
        self._delegate_tool = ConnectedAgentTool(
            agent_id=delegate_agent_id,
            description="{{ delegate.description if delegate else 'Specialist sub-agent' }}",
        )
        self._timeout = {{ timeout_seconds }}

    async def invoke(
        self,
        task: str,
        context: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        """Delegate task to {{ delegate.name if delegate else 'delegate' }} and return result."""
        start = datetime.now()
        context = context or {}

        agent = await self._client.agents.create_agent(
            model="gpt-4o",
            instructions=(
                "You are a delegation coordinator. "
                "Hand the task below to your connected agent and return its response."
            ),
            tools=self._delegate_tool.definitions,
            tool_resources=self._delegate_tool.resources,
        )
        thread = await self._client.agents.create_thread()
        await self._client.agents.create_message(
            thread_id=thread.id,
            role=MessageRole.USER,
            content=task,
        )

        run = await self._client.agents.create_and_process_run(
            thread_id=thread.id,
            agent_id=agent.id,
        )

        messages = await self._client.agents.list_messages(thread_id=thread.id)
        response = messages.get_last_text_message_by_role(MessageRole.ASSISTANT)
        result_text = response.text.value if response else ""

        await self._client.agents.delete_agent(agent.id)

        elapsed = (datetime.now() - start).total_seconds()
        if elapsed > self._timeout:
            logger.warning(
                "handoff[{{ handoff_name }}] exceeded %ds budget (%.1fs elapsed)",
                self._timeout, elapsed,
            )

        logger.info("handoff[{{ handoff_name }}] completed in %.1fs", elapsed)
        return {"result": result_text, "context": context, "run_id": run.id}
