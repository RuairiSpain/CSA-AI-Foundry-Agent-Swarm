from __future__ import annotations

import logging
from datetime import datetime
from typing import Any, Dict, List, Optional

from azure.ai.projects.aio import AIProjectClient
from azure.ai.projects.models import ConnectedAgentTool, MessageRole

logger = logging.getLogger(__name__)


class {{ class_name }}Handoff:
    """
    {{ handoff_name }}{% if description %} — {{ description }}{% endif %}

    Pattern       : {{ pattern }}
    Agent         : {{ recursive_agent.name if recursive_agent else 'agent' }}
    Max depth     : {{ max_depth }}
    Return policy : {{ return_policy }}
    Created       : {{ created_at }}

    Spawns depth-limited copies of the same agent type via ConnectedAgentTool.
    Each invocation may decide to recurse further by calling its connected
    sibling, up to max_depth levels. Results aggregate back up the call stack.

    Use this pattern when the task is self-similar — e.g. recursive document
    decomposition, tree traversal, or divide-and-conquer reasoning.
    """

    def __init__(
        self,
        client: AIProjectClient,
        recursive_agent_id: str,
    ) -> None:
        """
        Args:
            client: Authenticated AIProjectClient (async).
            recursive_agent_id: Azure agent ID for the recursive sub-agent.
        """
        self._client = client
        self._timeout = {{ timeout_seconds }}
        self._max_depth = {{ max_depth }}
        self._recursive_tool = ConnectedAgentTool(
            agent_id=recursive_agent_id,
            description="{{ recursive_agent.description if recursive_agent else 'Recursive sub-agent' }}",
        )

    async def invoke(
        self,
        task: str,
        context: Optional[Dict[str, Any]] = None,
        _depth: int = 0,
    ) -> Dict[str, Any]:
        """Recursively process the task up to max_depth levels."""
        start = datetime.now()
        context = context or {}

        if _depth >= self._max_depth:
            logger.info(
                "handoff[{{ handoff_name }}] base case at depth %d: returning task unmodified",
                _depth,
            )
            return {"result": task, "context": context, "depth": _depth, "base_case": True}

        agent = await self._client.agents.create_agent(
            model="gpt-4o",
            instructions=(
                f"You are a recursive processing agent at depth {_depth} "
                f"(max allowed: {self._max_depth - 1}). "
                f"Process the task. If the task can be broken into sub-tasks, "
                f"delegate them to your connected agent. Otherwise solve it directly."
            ),
            tools=self._recursive_tool.definitions,
            tool_resources=self._recursive_tool.resources,
        )
        thread = await self._client.agents.create_thread()
        await self._client.agents.create_message(
            thread_id=thread.id,
            role=MessageRole.USER,
            content=f"[depth={_depth}] {task}",
        )

        run = await self._client.agents.create_and_process_run(
            thread_id=thread.id,
            agent_id=agent.id,
        )

        messages = await self._client.agents.list_messages(thread_id=thread.id)
        response = messages.get_last_text_message_by_role(MessageRole.ASSISTANT)
        result_text = response.text.value if response else ""

        await self._client.agents.delete_agent(agent.id)

        elapsed = (datetime.now() - start).total_seconds()
        if elapsed > self._timeout:
            logger.warning(
                "handoff[{{ handoff_name }}] exceeded %ds budget at depth %d (%.1fs elapsed)",
                self._timeout, _depth, elapsed,
            )

        logger.info(
            "handoff[{{ handoff_name }}] depth %d completed in %.1fs", _depth, elapsed
        )
        return {
            "result": result_text,
            "context": context,
            "depth": _depth,
            "run_id": run.id,
            "base_case": False,
        }
