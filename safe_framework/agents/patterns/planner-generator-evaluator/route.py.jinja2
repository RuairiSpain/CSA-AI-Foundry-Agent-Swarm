                logger.info(f"Sprint {sprint_idx + 1} contract agreed in round {round_num + 1}")
                break

            proposal["feedback"] = eval_response.get("feedback", [])

        return SprintContract(
            sprint_index=sprint_idx,
            definition_of_done=proposal.get("definition_of_done", []),
            acceptance_criteria=proposal.get("acceptance_criteria", {}),
