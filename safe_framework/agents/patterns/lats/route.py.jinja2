    # ------------------------------------------------------------------
    # MCTS phases
    # ------------------------------------------------------------------

    def _select(self, root: _Node, tree: Dict[str, _Node]) -> _Node:
        """UCT traversal: descend the tree, always choosing the child with the
        highest UCT score, until we reach a leaf (unexpanded or terminal)."""
        node = root
        while node.children:
            unvisited = [
                tree[cid] for cid in node.children
                if not tree[cid].is_terminal and tree[cid].visits == 0
            ]
            if unvisited:
                return unvisited[0]
            eligible = [
                tree[cid] for cid in node.children if not tree[cid].is_terminal
            ]
            if not eligible:
                break
            node = max(eligible, key=lambda n: self._uct(n, node.visits))
        return node

    def _uct(self, node: _Node, parent_visits: int) -> float:
        """Upper Confidence Bound for Trees."""
        if node.visits == 0:
            return float("inf")
        exploitation = node.value / node.visits
        exploration  = {{ exploration_constant }} * math.sqrt(
            math.log(max(parent_visits, 1)) / node.visits
        )
        return exploitation + exploration

    def _backpropagate(
        self, node_id: str, reward: float, tree: Dict[str, _Node]
    ) -> None:
        """Walk from node_id to root, incrementing visits and accumulating reward."""
        nid: Optional[str] = node_id
        while nid is not None:
            n = tree[nid]
            n.visits += 1
            n.value  += reward
            nid = n.parent_id

    def _add_reflection(
        self, node_id: str, reflection: str, tree: Dict[str, _Node]
    ) -> None:
        """Propagate a failure reflection up to all ancestors so the selector
        can factor it into future UCT decisions via the expander's prompt."""
        nid: Optional[str] = tree[node_id].parent_id
        while nid is not None:
            tree[nid].reflections.append(reflection)
            nid = tree[nid].parent_id

    async def _exec_and_eval(
        self, parent: _Node, action: str
    ):
        """Execute one action and evaluate the resulting state.
        Returns (child_node, value, is_terminal)."""
        # Executor applies the action (MCP call, code run, API call, etc.)
        exec_result = await self.{{ executor_key }}.invoke({
            "state": parent.state,
            "action": action,
        })
        next_state: Dict[str, Any] = exec_result.get("next_state", {})

        # Evaluator scores the resulting state
        eval_result = await self.{{ evaluator_key }}.invoke({"state": next_state})
        value: float    = float(eval_result.get("value", 0.0))
        terminal: bool  = bool(eval_result.get("terminal", False))

        child = _Node(
            id=str(uuid.uuid4()),
            state=next_state,
            action_history=parent.action_history + [action],
            parent_id=parent.id,
            is_terminal=terminal,
        )
        return child, value, terminal

