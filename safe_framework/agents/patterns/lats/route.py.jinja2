                actions: List[str] = exp_result.get("actions", [])
                if not actions:
                    logger.warning("Expander returned no actions; skipping iteration")
                    continue

                # 3. Execution + evaluation — fan out in parallel
                exec_eval_tasks = [
                    self._exec_and_eval(node, action) for action in actions
                ]
                child_tuples = await asyncio.gather(*exec_eval_tasks, return_exceptions=True)

                for result in child_tuples:
                    if isinstance(result, Exception):
                        logger.warning(f"Child failed: {result}")
                        continue

                    child, value, terminal = result

                    # Register child in tree
