            for iteration in range({{ max_iterations }}):
                logger.debug(f"LATS iteration {iteration + 1}/{{ max_iterations }}")

                # 1. Selection — UCT traversal to the most promising leaf
                node = self._select(root, tree)

                if len(node.action_history) >= {{ max_depth }}:
                    logger.debug(f"Node at max depth {{ max_depth }}, skipping")
                    continue

                # 2. Expansion — LLM proposes branching_factor candidate actions
                exp_result = await self.{{ expander_key }}.invoke({
                    "state": node.state,
                    "action_history": node.action_history,
                    "reflections": node.reflections,
