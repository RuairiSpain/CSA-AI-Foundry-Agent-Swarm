# SAFE Framework — environment configuration reference
# Copy this file to .env and fill in values for your deployment.
# All variables are optional unless marked REQUIRED.

# ---------------------------------------------------------------------------
# Azure AI Foundry (required by MCP servers; not used by safe_core directly)
# ---------------------------------------------------------------------------

# REQUIRED for safe-model-router and safe-token-metrics MCP servers
FOUNDRY_ENDPOINT=https://<your-hub>.openai.azure.com
FOUNDRY_API_KEY=<your-foundry-api-key>

# Foundry Model Router deployment name (default: model-router)
MODEL_ROUTER_DEPLOYMENT=model-router

# ---------------------------------------------------------------------------
# Azure Durable Functions (required by safe-durable-task MCP server)
# ---------------------------------------------------------------------------

# REQUIRED for safe-durable-task MCP server
DURABLE_TASK_ENDPOINT=https://<your-function-app>.azurewebsites.net
DURABLE_TASK_KEY=<your-function-host-key>

# ---------------------------------------------------------------------------
# SAFE runtime timeouts
# ---------------------------------------------------------------------------

# Default timeout for a single route execution (seconds, default: 300)
SAFE_EXECUTION_DEFAULT_TIMEOUT_SECONDS=300

# Default timeout for individual agent invocations (seconds, default: 3600)
SAFE_AGENT_DEFAULT_TIMEOUT_SECONDS=3600

# ---------------------------------------------------------------------------
# Code-generator loop controls
# ---------------------------------------------------------------------------

# Maximum retries in retry-loop pattern (default: 3)
SAFE_RETRY_LOOP_MAX_RETRIES=3

# Maximum agent spawns in ralph-loop pattern (default: 10)
SAFE_RALPH_LOOP_SPAWN_BUDGET=10

# ---------------------------------------------------------------------------
# Governance approvers
# ---------------------------------------------------------------------------

# Approver emails used by the approval engine when assigning reviewers
SAFE_APPROVER_FINANCE_LEAD=finance-lead@company.com
SAFE_APPROVER_SECURITY_LEAD=security-lead@company.com
SAFE_APPROVER_TEAM_LEAD=team-lead@company.com

# Cost fraction above which finance + security leads are required (default: 0.5)
# e.g. 0.5 means routes costing >50% of the policy cap require senior approval
SAFE_HIGH_COST_APPROVER_THRESHOLD_FACTOR=0.5

# ---------------------------------------------------------------------------
# Health monitoring thresholds
# ---------------------------------------------------------------------------

# Consecutive failures before a route enters WARN_FAILING state (default: 2)
SAFE_HEALTH_FAILURE_THRESHOLD=2

# Execution time above which a run is counted as slow (ms, default: 5000)
SAFE_HEALTH_SLOW_THRESHOLD_MS=5000.0

# Monthly cost above which a route triggers a WARN_COST alert (USD, default: 1000)
SAFE_HEALTH_COST_THRESHOLD_USD=1000.0

# Inactivity period before a route is marked FROZEN (seconds, default: 3600)
SAFE_HEALTH_FROZEN_THRESHOLD_SECONDS=3600

# ---------------------------------------------------------------------------
# Test / analysis (not used at runtime)
# ---------------------------------------------------------------------------

# Token budget for agent.md token-budget tests (default: 8000)
# MD_TOKEN_BUDGET=8000
